# Provide EITHER a static API token, OR email + password for auto-login.
# If both are set, the static token is tried first and email/password is used
# as a fallback when the token is rejected as expired.

# Static token (from seller dashboard: My profile -> API developer -> API Token)
COD_NETWORK_API_TOKEN=your-token-here

# Auto-login mode (recommended for long-running servers): the MCP will call
# POST /seller/login on startup and re-login automatically on 401.
# COD_NETWORK_EMAIL=you@example.com
# COD_NETWORK_PASSWORD=your-password

# Optional: override the API base URL (rarely needed)
# COD_NETWORK_BASE_URL=https://api.cod.network/v2

# Optional: request timeout in milliseconds (default 30000)
# COD_NETWORK_TIMEOUT_MS=30000
