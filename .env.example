# API token (required) — from seller dashboard: My profile -> API developer -> API Token
COD_NETWORK_API_TOKEN=your-token-here

# Optional: override the API base URL (rarely needed)
# COD_NETWORK_BASE_URL=https://api.cod.network/v2

# Optional: request timeout in milliseconds (default 30000)
# COD_NETWORK_TIMEOUT_MS=30000
